def APNRedo.APN.{u_1} : {E : Type u_1} → [inst : AddCommGroup E] → (E → E) → Prop :=
fun {E} [AddCommGroup E] f =>
  ∀ (a : E),
    a ≠ 0 → ∀ (c x y z : E), f (x + a) + f x = c → f (y + a) + f y = c → f (z + a) + f z = c → x = y ∨ x = z ∨ y = z
def APNRedo.normalizedPolar.{u_1} : {E : Type u_1} → [inst : AddCommGroup E] → (E → E) → E → E → E :=
fun {E} [AddCommGroup E] f x y => f (x + y) + f x + f y + f 0
def APNRedo.encodedFunction : (APNRedo.V 8 → APNRedo.V 8) → BitVec 8 → BitVec 8 :=
fun f x => QuadraticWalshMatrix.decode (f (QuadraticWalshMatrix.coords x))
def APNRedo.nonBentFunctionLabels : (APNRedo.V 8 → APNRedo.V 8) → Finset (APNRedo.V 8) :=
fun f => {b ∈ Finset.univ.erase 0 | ¬FastWalsh.IsBent (APNRedo.encodedFunction f) (QuadraticWalshMatrix.decode b)}
def FastWalsh.IsBent : {n m : ℕ} → (BitVec n → BitVec m) → BitVec m → Prop :=
fun {n m} f b => ∀ (u : BitVec n), FastWalsh.walsh f b u * FastWalsh.walsh f b u = ↑(2 ^ n)
