import Std
import Std.Sat.CNF.Basic

namespace LocalIdentifyingQ6.CardinalityEncoding

def prefixCount (X : Nat → Bool) : Nat → Nat
  | 0 => 0
  | n+1 => prefixCount X n + if X (n+1) then 1 else 0

/-- PySAT sequential-counter variable numbering, read directly against the persisted CNF. -/
def position (v : Nat) : Nat :=
  if v ≤ 90 then (v - 64) / 2 + 1 else (v - 91) / 13 + 3 + (v - 91) % 13

def threshold (v : Nat) : Nat :=
  if v ≤ 90 then (v - 63) / 2 else (v - 91) % 13 + 1

def assignment (X : Nat → Bool) (v : Nat) : Bool :=
  if v ≤ 64 then X v else decide (threshold v ≤ prefixCount X (position v))

inductive Step where
  | input (x s : Nat)
  | carry (a b : Nat)
  | increment (x a b : Nat)
  | overflow (x a : Nat)
  deriving Repr

def Step.clause : Step → Std.Sat.CNF.Clause Nat
  | .input x s => [(x, false), (s, true)]
  | .carry a b => [(a, false), (b, true)]
  | .increment x a b => [(x, false), (a, false), (b, true)]
  | .overflow x a => [(x, false), (a, false)]

def Step.Valid : Step → Prop
  | .input x s => 0 < x ∧ x ≤ 64 ∧ 64 < s ∧ position s = x ∧ threshold s = 1
  | .carry a b => 64 < a ∧ 64 < b ∧ position a ≤ position b ∧ threshold a = threshold b
  | .increment x a b => 0 < x ∧ x ≤ 64 ∧ 64 < a ∧ 64 < b ∧ x = position a + 1 ∧ position b = x ∧ threshold b = threshold a + 1
  | .overflow x a => 0 < x ∧ x ≤ 64 ∧ 64 < a ∧ x = position a + 1 ∧ threshold a = 13

instance (s : Step) : Decidable s.Valid := by cases s <;> unfold Step.Valid <;> infer_instance

