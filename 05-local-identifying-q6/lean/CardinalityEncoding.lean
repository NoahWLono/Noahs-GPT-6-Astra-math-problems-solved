def clauses : Std.Sat.CNF Nat := steps.map Step.clause

theorem prefix_mono (X : Nat → Bool) {a b : Nat} (h : a ≤ b) :
    prefixCount X a ≤ prefixCount X b := by
  induction b with
  | zero => have : a = 0 := by omega
            simp [this]
  | succ b ih =>
    by_cases hh : a ≤ b
    · have := ih hh
      simp only [prefixCount]
      split <;> omega
    · have : a = b+1 := by omega
      simp [this]

theorem assignment_input (X : Nat → Bool) (v : Nat) (h : v ≤ 64) :
    assignment X v = X v := by simp [assignment, h]

theorem assignment_aux (X : Nat → Bool) (v : Nat) (h : 64 < v) :
    assignment X v = decide (threshold v ≤ prefixCount X (position v)) := by
  simp [assignment, show ¬ v ≤ 64 by omega]

theorem step_sound (X : Nat → Bool) (bound : prefixCount X 64 ≤ 13)
    (s : Step) (valid : s.Valid) : s.clause.eval (assignment X) = true := by
  cases s with
  | input x s =>
    rcases valid with ⟨hx, h64, hs, hp, ht⟩
    simp only [Step.clause, Std.Sat.CNF.Clause.eval_cons,
      Std.Sat.CNF.Clause.eval_nil, assignment_input X x h64, assignment_aux X s hs, hp, ht]
    have hprefix : X x = true → 1 ≤ prefixCount X x := by
      intro h
      obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : x ≠ 0)
      simp [prefixCount, h]
    cases h : X x <;> simp_all
  | carry a b =>
    rcases valid with ⟨ha, hb, hp, ht⟩
    simp only [Step.clause, Std.Sat.CNF.Clause.eval_cons,
      Std.Sat.CNF.Clause.eval_nil, assignment_aux X a ha, assignment_aux X b hb]
    have hm := prefix_mono X hp
    by_cases hh : threshold a ≤ prefixCount X (position a)
    · have hh' : threshold b ≤ prefixCount X (position b) := by omega
      simp [hh, hh']
    · simp [hh]
  | increment x a b =>
    rcases valid with ⟨hx, h64, ha, hb, hp, hpb, ht⟩
    simp only [Step.clause, Std.Sat.CNF.Clause.eval_cons,
      Std.Sat.CNF.Clause.eval_nil, assignment_input X x h64,
      assignment_aux X a ha, assignment_aux X b hb]
    cases hh : X x
    · simp
    · have he : prefixCount X x = prefixCount X (position a) + 1 := by
        rw [hp, prefixCount]
        simp [← hp, hh]
      by_cases hh' : threshold a ≤ prefixCount X (position a)
      · have hh'' : threshold b ≤ prefixCount X (position b) := by rw [hpb]; omega
        simp [hh', hh'']
      · simp [hh']
  | overflow x a =>
    rcases valid with ⟨hx, h64, ha, hp, ht⟩
    simp only [Step.clause, Std.Sat.CNF.Clause.eval_cons,
      Std.Sat.CNF.Clause.eval_nil, assignment_input X x h64, assignment_aux X a ha]
    cases hh : X x
    · simp
    · have he : prefixCount X x = prefixCount X (position a) + 1 := by
        rw [hp, prefixCount]
        simp [← hp, hh]
      have hm := prefix_mono X h64
      have hh' : ¬ threshold a ≤ prefixCount X (position a) := by omega
      simp [hh']

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem steps_valid : ∀ s ∈ steps, s.Valid := by
  have h : steps.all (fun s => decide s.Valid) = true := by decide +kernel
  simpa only [List.all_eq_true, decide_eq_true_eq] using h

theorem clauses_satisfied (X : Nat → Bool) (bound : prefixCount X 64 ≤ 13) :
    clauses.eval (assignment X) = true := by
  simp only [clauses, Std.Sat.CNF.eval, List.all_map, List.all_eq_true]
  intro s hs
  exact step_sound X bound s (steps_valid s hs)

#print axioms clauses_satisfied
end LocalIdentifyingQ6.CardinalityEncoding
