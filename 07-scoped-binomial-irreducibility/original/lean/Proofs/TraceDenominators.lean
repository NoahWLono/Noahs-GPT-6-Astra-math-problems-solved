import PurePowerTrace
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.Data.Rat.Lemmas

/-! Integral-coordinate bounds obtained from the actual pure-power trace computations. -/
set_option autoImplicit false
open scoped BigOperators
open Algebra Polynomial IntermediateField
namespace PillaiTrace
universe u
variable {L : Type u} [Field L] [Algebra ℚ L]

/-- The integer pure-power relation supplies the monic polynomial proving generator integrality. -/
lemma integral_gen_of_pure_power (B : PowerBasis ℚ L) (k : ℤ)
    (hpow : B.gen^B.dim=(k : L)) : IsIntegral ℤ B.gen := by
  refine ⟨(X : ℤ[X])^B.dim-C k,monic_X_pow_sub_C _ (Nat.ne_of_gt B.dim_pos),?_⟩
  rw [eval₂_sub,eval₂_pow,eval₂_X,eval₂_C,sub_eq_zero]
  simpa using hpow

lemma trace_is_integer (B : PowerBasis ℚ L) (z : L) (hz : IsIntegral ℤ z) :
    ∃ a : ℤ,(a : ℚ)=Algebra.trace ℚ L z := by
  letI : FiniteDimensional ℚ L := B.finite
  exact IsIntegrallyClosed.algebraMap_eq_of_integral (Algebra.isIntegral_trace hz)

/-- Exact rational coordinate denominator bounds in an actual pure power basis. -/
theorem integral_coordinate_bounds (B : PowerBasis ℚ L) (k : ℤ)
    (hpow : B.gen^B.dim=(k : L)) (z : L) (hz : IsIntegral ℤ z) :
    (∃ a : ℤ,(a : ℚ)=(B.dim : ℚ)*B.basis.repr z ⟨0,B.dim_pos⟩) ∧
    ∀ j : Fin B.dim,0<j.val →
      ∃ a : ℤ,(a : ℚ)=(B.dim : ℚ)*(k : ℚ)*B.basis.repr z j := by
  have hp : B.gen^B.dim=algebraMap ℚ L (k : ℚ) := by simpa using hpow
  constructor
  · simpa only [trace_eq_constant_coordinate B (k : ℚ) hp z] using trace_is_integer B z hz
  · intro j hj
    have hi := hz.mul ((integral_gen_of_pure_power B k hpow).pow (B.dim-j.val))
    simpa only [trace_mul_eq_coordinate B (k : ℚ) hp z j hj] using
      trace_is_integer B (z*B.gen^(B.dim-j.val)) hi

/-- The same bounds for an explicit rational coefficient vector, with no assumed trace identity. -/
theorem coefficient_bounds (B : PowerBasis ℚ L) (k : ℤ)
    (hpow : B.gen^B.dim=(k : L)) (c : Fin B.dim → ℚ)
    (hz : IsIntegral ℤ (∑ j,(c j : L)*B.gen^j.val)) :
    (∃ a : ℤ,(a : ℚ)=(B.dim : ℚ)*c ⟨0,B.dim_pos⟩) ∧
    ∀ j : Fin B.dim,0<j.val → ∃ a : ℤ,(a : ℚ)=(B.dim : ℚ)*(k : ℚ)*c j := by
  have hz' : IsIntegral ℤ (∑ j,c j • B.gen^j.val) := by
    simpa only [Algebra.smul_def,eq_ratCast] using hz
  have hh := integral_coordinate_bounds B k hpow _ hz'
  simpa only [← B.basis_eq_pow,Module.Basis.repr_sum_self] using hh

/-- Natural formulation at a root of an irreducible integer pure binomial.
The ambient field need not itself be generated by the root. -/
theorem irreducible_coefficient_bounds (n : ℕ) (hn : 1≤n) (k : ℤ) (θ : L)
    (hpow : θ^n=(k : L)) (hirr : Irreducible ((X : ℚ[X])^n-C (k : ℚ)))
    (c : Fin n → ℚ) (hz : IsIntegral ℤ (∑ j,(c j : L)*θ^j.val)) :
    (∃ a : ℤ,(a : ℚ)=(n : ℚ)*c ⟨0,by omega⟩) ∧
    ∀ j : Fin n,0<j.val → ∃ a : ℤ,(a : ℚ)=(n : ℚ)*(k : ℚ)*c j := by
  have hmon : ((X : ℚ[X])^n-C (k : ℚ)).Monic := monic_X_pow_sub_C _ (by omega)
  have hroot : aeval θ ((X : ℚ[X])^n-C (k : ℚ))=0 := by
    simp only [map_sub,map_pow,aeval_X,aeval_C]
    simpa only [map_intCast,sub_eq_zero] using hpow
  have hmin := minpoly.eq_of_irreducible_of_monic hirr hroot hmon
  have hθ : IsIntegral ℚ θ := ⟨_,hmon,hroot⟩
  let B₀ := IntermediateField.adjoin.powerBasis hθ
  have hdim : B₀.dim=n := by
    change (minpoly ℚ θ).natDegree=n
    rw [← hmin,natDegree_X_pow_sub_C]
  let B : PowerBasis ℚ ℚ⟮θ⟯ :=
    { gen := B₀.gen
      dim := n
      basis := B₀.basis.reindex (finCongr hdim)
      basis_eq_pow := by
        intro i
        simp only [Module.Basis.reindex_apply,B₀.basis_eq_pow,finCongr_symm,finCongr_apply,Fin.val_cast] }
  have hgen : (algebraMap ℚ⟮θ⟯ L) B.gen=θ := rfl
  have hp : B.gen^B.dim=(k : ℚ⟮θ⟯) := by
    apply (algebraMap ℚ⟮θ⟯ L).injective
    simpa only [map_pow,map_intCast,hgen] using hpow
  have hz' : IsIntegral ℤ (∑ j : Fin B.dim,(c j : ℚ⟮θ⟯)*B.gen^j.val) := by
    apply (isIntegral_algebraMap_iff (algebraMap ℚ⟮θ⟯ L).injective).mp
    simpa only [map_sum,map_mul,map_ratCast,map_pow,hgen] using hz
  exact coefficient_bounds B k hp c hz'

lemma denominator_dvd_of_integer_multiple (r : ℚ) (d a : ℤ)
    (ha : (a : ℚ)=(d : ℚ)*r) : (r.den : ℤ)∣d := by
  by_cases hd : d=0
  · simp [hd]
  · have hd' : (d : ℚ)≠0 := by exact_mod_cast hd
    have hr : r=Rat.divInt a d := by
      rw [Rat.divInt_eq_div,eq_div_iff hd']
      simpa only [mul_comm] using ha.symm
    rw [hr]
    exact Rat.den_dvd a d

/-- The reduced rational denominators divide the displayed integers, including the sharper
constant-coordinate bound. -/
theorem irreducible_denominator_dvd (n : ℕ) (hn : 1≤n) (k : ℤ) (θ : L)
    (hpow : θ^n=(k : L)) (hirr : Irreducible ((X : ℚ[X])^n-C (k : ℚ)))
    (c : Fin n → ℚ) (hz : IsIntegral ℤ (∑ j,(c j : L)*θ^j.val)) :
    ((c ⟨0,by omega⟩).den : ℤ)∣(n : ℤ) ∧
    ∀ j : Fin n,0<j.val → ((c j).den : ℤ)∣(n : ℤ)*k := by
  obtain ⟨hc₀,hc⟩ := irreducible_coefficient_bounds n hn k θ hpow hirr c hz
  constructor
  · obtain ⟨a,ha⟩ := hc₀
    exact denominator_dvd_of_integer_multiple _ n a (by simpa only [Int.cast_natCast] using ha)
  · intro j hj
    obtain ⟨a,ha⟩ := hc j hj
    exact denominator_dvd_of_integer_multiple _ ((n : ℤ)*k) a (by
      simpa only [Int.cast_mul,Int.cast_natCast] using ha)

/-- Multiplication by nκ puts the actual integral element in the integer power order. -/
theorem degree_parameter_mul_mem_order (n : ℕ) (hn : 1≤n) (k : ℤ) (θ : L)
    (hpow : θ^n=(k : L)) (hirr : Irreducible ((X : ℚ[X])^n-C (k : ℚ)))
    (c : Fin n → ℚ) (hz : IsIntegral ℤ (∑ j,(c j : L)*θ^j.val)) :
    (n : L)*(k : L)*(∑ j,(c j : L)*θ^j.val)∈Algebra.adjoin ℤ ({θ} : Set L) := by
  classical
  obtain ⟨hc₀,hc⟩ := irreducible_coefficient_bounds n hn k θ hpow hirr c hz
  rw [Finset.mul_sum]
  apply Subalgebra.sum_mem
  intro j _
  have hex : ∃ a : ℤ,(a : ℚ)=(n : ℚ)*(k : ℚ)*c j := by
    by_cases hj : j.val=0
    · have hj₀ : j=⟨0,by omega⟩ := Fin.ext hj
      obtain ⟨a,ha⟩ := hc₀
      refine ⟨k*a,?_⟩
      rw [Int.cast_mul,ha,hj₀]
      ring
    · exact hc j (Nat.pos_of_ne_zero hj)
  obtain ⟨a,ha⟩ := hex
  have haL : (a : L)=(n : L)*(k : L)*(c j : L) := by
    simpa only [map_mul,map_natCast,map_intCast,eq_ratCast] using congrArg (algebraMap ℚ L) ha
  rw [← mul_assoc,← haL]
  exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ a)
    (Subalgebra.pow_mem _ (self_mem_adjoin_singleton ℤ θ) _)

end PillaiTrace
