import QuarticOperatorOrder
import QuarticPolynomial

/-!
Full quotient-operator separation for the fixed rational mixed quartic in four
variables. `generated` contains arbitrary finite compositions and linear
combinations of multiplication maps and all actual quotient derivations.
This concrete statement does not assert the unrestricted Nakai conjecture.
-/

noncomputable section
open MvPolynomial
open scoped BigOperators

namespace NakaiQuartic
open NakaiFramework

/-- The actual coordinate ring of the explicitly defined mixed quartic. -/
abbrev A := P ⧸ Ideal.span ({F} : Set P)

/-- A genuine second-order operator on the fixed quotient ring lies outside the
entire algebra generated by multiplication and all derivations. The universal
evaluation clause identifies the witness with the explicit cofactor operator.
-/
theorem quartic_full_operator_separation :
    ∃ Q : Module.End ℚ A,
      (∀ p : P, Q (Ideal.Quotient.mk _ p) = Ideal.Quotient.mk _ (QP p)) ∧
      IsOrderLE2 Q ∧ Q ∉ generated := by
  exact quotient_separator_of_certificates F QP 0
    F_mem_J QP_F_mul_mem QP_orderLE2 QP_G0_not_mem_J

#print axioms NakaiQuartic.quartic_full_operator_separation

end NakaiQuartic
