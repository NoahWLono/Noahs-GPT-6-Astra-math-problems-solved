import NakaiHomogeneousEscape
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum

/-!
Conditional generic ordinary-homogeneous separator. The explicit assumption
`h f ∉ gradientIdeal f` is NOT proved here from isolatedness: that is the missing
classical Jacobian--socle dependency. This module does not claim a formalization
of the full isolated homogeneous class, nor mathematical novelty.
-/
noncomputable section
open MvPolynomial
open scoped BigOperators
namespace NakaiHomogeneous
open NakaiFramework
variable {k ι : Type*} [Field k] [CharZero k] [Fintype ι] [DecidableEq ι]

lemma escape_scalar_ne_zero (n d : ℕ) (hn : 3 ≤ n) (hd : 2 ≤ d) :
    (n : k)*(d : k)-(n : k)-(d : k) ≠ 0 := by
  have hn' : (3 : ℤ) ≤ n := by exact_mod_cast hn
  have hd' : (2 : ℤ) ≤ d := by exact_mod_cast hd
  have hp : 0 < ((n : ℤ)-2)*((d : ℤ)-1) := mul_pos (by linarith) (by linarith)
  have hz : (n : ℤ)*(d : ℤ)-(n : ℤ)-(d : ℤ) ≠ 0 := by
    apply ne_of_gt
    nlinarith
  have hc : (((n : ℤ)*(d : ℤ)-(n : ℤ)-(d : ℤ) : ℤ) : k) ≠ 0 := Int.cast_ne_zero.mpr hz
  simpa only [Int.cast_sub, Int.cast_mul, Int.cast_natCast] using hc

omit [DecidableEq ι] in
lemma f_mem_gradient (f : P (k := k) (ι := ι)) (d : ℕ)
    (hf : f.IsHomogeneous d) (hd : 2 ≤ d) : f ∈ gradientIdeal f := by
  have hd0 : d ≠ 0 := Nat.ne_of_gt (lt_of_lt_of_le (by decide : 0 < 2) hd)
  have hd0k : (d : k) ≠ 0 := Nat.cast_ne_zero.mpr hd0
  have he : (∑ i, X i * pderiv i f) = (d : k) • f := by
    simpa only [Algebra.smul_def, algebraMap_eq, map_natCast] using euler_f f d hf
  apply Ideal.mem_span_range_iff_exists_fun.mpr
  refine ⟨fun i => (d : k)⁻¹ • (X i : P (k := k) (ι := ι)), ?_⟩
  simp only [smul_mul_assoc, ← Finset.smul_sum, he, smul_smul, inv_mul_cancel₀ hd0k,
    one_smul]

lemma QP_gradient_not_mem (f : P (k := k) (ι := ι)) (d : ℕ)
    (hf : f.IsHomogeneous d) (hd : 2 ≤ d) (hn : 3 ≤ Fintype.card ι)
    (hh : h f ∉ gradientIdeal f) (r : ι) :
    QP f d r (pderiv r f) ∉ gradientIdeal f := by
  intro hq
  let c : k := (Fintype.card ι : k)*(d : k)-(Fintype.card ι : k)-(d : k)
  have hc : c ≠ 0 := escape_scalar_ne_zero _ _ hn hd
  have herror : ((d : P (k := k) (ι := ι))-1) *
      (∑ i, pderiv r (U f i r) * pderiv i f) ∈ gradientIdeal f := by
    apply Ideal.mul_mem_left
    apply Ideal.sum_mem
    intro i _
    exact Ideal.mul_mem_left _ _ (partial_mem_gradient f i)
  have hmain : MvPolynomial.C c * h f ∈ gradientIdeal f := by
    have hm := (gradientIdeal f).add_mem hq herror
    rw [QP_gradient f d hf hd r, sub_add_cancel] at hm
    simpa only [c, map_sub, map_mul, map_natCast] using hm
  apply hh
  have hm := Ideal.mul_mem_left (gradientIdeal f) (MvPolynomial.C c⁻¹) hmain
  simpa only [← mul_assoc, ← map_mul, inv_mul_cancel₀ hc, map_one, one_mul] using hm

/-- Conditional on explicit Hessian nonmembership, the displayed ordinary
homogeneous operator separates from the full algebra generated by all quotient
derivations and multiplications. The classical socle implication from isolatedness
is deliberately absent from the hypotheses and conclusions of this formal module. -/
theorem conditional_full_operator_separation
    (f : P (k := k) (ι := ι)) (d : ℕ)
    (hf : f.IsHomogeneous d) (hd : 2 ≤ d) (hn : 3 ≤ Fintype.card ι)
    (hh : h f ∉ gradientIdeal f) (r : ι) :
    ∃ Q : Module.End k (P (k := k) (ι := ι) ⧸ Ideal.span ({f} : Set (P (k := k) (ι := ι)))),
      (∀ p, Q (Ideal.Quotient.mk _ p) = Ideal.Quotient.mk _ (QP f d r p)) ∧
      IsOrderLE2 Q ∧ Q ∉ generated := by
  exact quotient_separator_of_certificates f (QP f d r) r
    (f_mem_gradient f d hf hd) (QP_f_mul_mem f d hf hd r) (QP_orderLE2 f d r)
    (QP_gradient_not_mem f d hf hd hn hh r)

#print axioms conditional_full_operator_separation
end NakaiHomogeneous
