import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.Algebra.MvPolynomial.PDeriv
import Mathlib.LinearAlgebra.Quotient.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Tactic.NoncommRing
import Mathlib.Tactic.Ring

/-!
A faithful endomorphism framework for the full generated differential-operator
algebra. No restriction on the number of derivation factors occurs in `generated`.
`IsOrderLE2` is the usual triple-commutator characterization of order at most two.
-/

noncomputable section
open scoped BigOperators

namespace NakaiFramework

section Operators
variable {k R : Type*} [Field k] [CommRing R] [Algebra k R]

/-- Multiplication as a linear endomorphism. -/
def mulEnd (a : R) : Module.End k R where
  toFun x := a * x
  map_add' x y := mul_add a x y
  map_smul' r x := by simp [Algebra.smul_def, mul_left_comm]

@[simp] theorem mulEnd_apply (a x : R) : mulEnd (k := k) a x = a * x := rfl

/-- Commutator with multiplication, with the operator in the first slot. -/
def comm (T : Module.End k R) (a : R) : Module.End k R :=
  T * mulEnd a - mulEnd a * T

@[simp] theorem comm_apply (T : Module.End k R) (a x : R) :
    comm T a x = T (a * x) - a * T x := rfl

/-- The standard faithful endomorphism definition of differential order <= 2. -/
def IsOrderLE2 (T : Module.End k R) : Prop :=
  ∀ a b c : R, comm (comm (comm T a) b) c = 0

@[simp] theorem comm_zero (a : R) : comm (0 : Module.End k R) a = 0 := by
  ext x
  simp

@[simp] theorem comm_add (S T : Module.End k R) (a : R) :
    comm (S + T) a = comm S a + comm T a := by
  ext x
  simp only [comm_apply, LinearMap.add_apply]
  ring

@[simp] theorem comm_sum {ι : Type*} (s : Finset ι) (T : ι → Module.End k R) (a : R) :
    comm (∑ i ∈ s, T i) a = ∑ i ∈ s, comm (T i) a := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih => simp [hi, ih]

@[simp] theorem comm_mul (S T : Module.End k R) (a : R) :
    comm (S * T) a = S * comm T a + comm S a * T := by
  unfold comm
  simp only [mul_sub, sub_mul, mul_assoc]
  abel

@[simp] theorem comm_mulEnd (a b : R) : comm (mulEnd (k := k) a) b = 0 := by
  ext x
  simp only [comm_apply, mulEnd_apply, LinearMap.zero_apply]
  ring

@[simp] theorem comm_derivation (D : Derivation k R R) (a : R) :
    comm D.toLinearMap a = mulEnd (D a) := by
  ext x
  change D (a * x) - a * D x = D a * x
  rw [D.leibniz]
  simp only [smul_eq_mul]
  ring

@[simp] theorem derivation_sum_apply {ι : Type*} (s : Finset ι)
    (D : ι → Derivation k R R) (p : R) :
    (∑ i ∈ s, D i) p = ∑ i ∈ s, D i p := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih => simp [hi, ih, Derivation.add_apply]

/-- Every coefficient times a derivation composition of length at most two
has differential order at most two. This says nothing about arbitrary word
lengths in the generated algebra. -/
theorem orderLE2_secondOrder {ι : Type*} [Fintype ι]
    (B : ι → ι → R) (a : ι → R) (D : ι → Derivation k R R) :
    IsOrderLE2
      ((∑ i, ∑ j, mulEnd (B i j) * (D i).toLinearMap * (D j).toLinearMap) +
        ∑ i, mulEnd (a i) * (D i).toLinearMap) := by
  classical
  intro x y z
  simp only [comm_add, comm_sum, comm_mul, comm_mulEnd, comm_derivation,
    mul_zero, zero_mul, add_zero, zero_add, Finset.sum_const_zero]

/-- Full algebra generated by all multiplication maps and all actual derivations. -/
def generated : Subalgebra k (Module.End k R) :=
  Algebra.adjoin k
    (Set.range (mulEnd (k := k) (R := R)) ∪
      Set.range (fun D : Derivation k R R => D.toLinearMap))

/-- Endomorphisms preserving an ideal form a subalgebra. -/
def stabilizer (I : Ideal R) : Subalgebra k (Module.End k R) where
  carrier := {T | ∀ x, x ∈ I → T x ∈ I}
  zero_mem' := by intro x hx; exact I.zero_mem
  one_mem' := by intro x hx; exact hx
  add_mem' := by intro S T hS hT x hx; exact I.add_mem (hS x hx) (hT x hx)
  mul_mem' := by intro S T hS hT x hx; exact hS (T x) (hT x hx)
  algebraMap_mem' := by
    intro c x hx
    change c • x ∈ I
    simpa [Algebra.smul_def] using I.mul_mem_left (algebraMap k R c) hx

theorem generated_le_stabilizer (I : Ideal R)
    (hD : ∀ D : Derivation k R R, ∀ x, x ∈ I → D x ∈ I) :
    generated (k := k) (R := R) ≤ stabilizer I := by
  apply Algebra.adjoin_le
  intro T hT
  rcases hT with ⟨a, rfl⟩ | ⟨D, rfl⟩
  · intro x hx
    exact I.mul_mem_left a hx
  · exact hD D

theorem not_generated_of_escape (I : Ideal R)
    (hD : ∀ D : Derivation k R R, ∀ x, x ∈ I → D x ∈ I)
    (T : Module.End k R) (x : R) (hx : x ∈ I) (hTx : T x ∉ I) :
    T ∉ generated (k := k) (R := R) := by
  intro hT
  exact hTx (generated_le_stabilizer I hD hT x hx)

end Operators

section Transport
variable {k R A : Type*} [Field k] [CommRing R] [CommRing A]
  [Algebra k R] [Algebra k A]

lemma comm_compatible (π : R →ₐ[k] A) (S : Module.End k R) (T : Module.End k A)
    (h : ∀ p, T (π p) = π (S p)) (a p : R) :
    comm T (π a) (π p) = π (comm S a p) := by
  simp only [comm_apply, ← map_mul, h, map_sub]

theorem orderLE2_of_surjective (π : R →ₐ[k] A) (hπ : Function.Surjective π)
    (S : Module.End k R) (T : Module.End k A)
    (h : ∀ p, T (π p) = π (S p)) (hS : IsOrderLE2 S) : IsOrderLE2 T := by
  intro a b c
  obtain ⟨a, rfl⟩ := hπ a
  obtain ⟨b, rfl⟩ := hπ b
  obtain ⟨c, rfl⟩ := hπ c
  ext x
  obtain ⟨p, rfl⟩ := hπ x
  have h1 := comm_compatible π S T h a
  have h2 := comm_compatible π (comm S a) (comm T (π a)) h1 b
  have h3 := comm_compatible π (comm (comm S a) b) (comm (comm T (π a)) (π b)) h2 c p
  rw [h3, hS a b c]
  simp

/-- A linear operator preserving an ideal descends to the actual ring quotient. -/
def quotientEnd (I : Ideal R) (T : Module.End k R)
    (hT : ∀ p, p ∈ I → T p ∈ I) : Module.End k (R ⧸ I) :=
  let V := I.restrictScalars k
  let e := Submodule.Quotient.restrictScalarsEquiv k I
  e.toLinearMap.comp
    ((V.mapQ V T (by intro p hp; exact hT p hp)).comp e.symm.toLinearMap)

@[simp] theorem quotientEnd_mk (I : Ideal R) (T : Module.End k R)
    (hT : ∀ p, p ∈ I → T p ∈ I) (p : R) :
    quotientEnd I T hT (Ideal.Quotient.mk I p) = Ideal.Quotient.mk I (T p) := rfl

theorem quotient_not_mem_map {I J : Ideal R} (hIJ : I ≤ J) {p : R} (hp : p ∉ J) :
    Ideal.Quotient.mk I p ∉ Ideal.map (Ideal.Quotient.mk I) J := by
  intro h
  obtain ⟨q, hq, heq⟩ :=
    (Ideal.mem_map_iff_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective).mp h
  have hqp : q - p ∈ J := hIJ ((Ideal.Quotient.eq (I := I)).mp heq)
  have hp' := J.sub_mem hq hqp
  apply hp
  simpa using hp'

end Transport

section PolynomialJacobian
variable {k ι : Type*} [Field k] [Fintype ι] [DecidableEq ι]
open MvPolynomial

abbrev Poly := MvPolynomial ι k

/-- The gradient ideal in the polynomial ring. -/
def gradientIdeal (f : Poly (k := k) (ι := ι)) : Ideal (Poly (k := k) (ι := ι)) :=
  Ideal.span (Set.range (fun i => pderiv i f))

lemma partial_mem_gradient (f : Poly (k := k) (ι := ι)) (i : ι) :
    pderiv i f ∈ gradientIdeal f := Ideal.subset_span ⟨i, rfl⟩

/-- Polynomial coefficient derivation with prescribed coordinate values. -/
def coeffDerivation (u : ι → Poly (k := k) (ι := ι)) : Derivation k (Poly (k := k) (ι := ι)) (Poly (k := k) (ι := ι)) :=
  ∑ i, u i • pderiv i

@[simp] lemma coeffDerivation_apply (u : ι → Poly (k := k) (ι := ι)) (p : Poly (k := k) (ι := ι)) :
    coeffDerivation u p = ∑ i, u i * pderiv i p := by
  simp [coeffDerivation, smul_eq_mul]

@[simp] lemma coeffDerivation_X (u : ι → Poly (k := k) (ι := ι)) (i : ι) :
    coeffDerivation u (X i) = u i := by
  simp [coeffDerivation_apply, pderiv_X, Pi.single_apply]

lemma pderiv_comm (i j : ι) (p : Poly (k := k) (ι := ι)) :
    pderiv i (pderiv j p) = pderiv j (pderiv i p) := by
  induction p using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp [map_add, hp, hq]
  | mul_X p t hp =>
      by_cases hij : i = j
      · subst j
        rfl
      · by_cases hi : t = i <;> by_cases hj : t = j <;>
          simp [pderiv_mul, map_add, pderiv_X, Pi.single_apply,
            hi, hj, hij, Ne.symm hij, hp, eq_comm] <;> ring

lemma pderiv_coeffDerivation (u : ι → Poly (k := k) (ι := ι)) (p : Poly (k := k) (ι := ι)) (j : ι) :
    pderiv j (coeffDerivation u p) =
      (∑ i, pderiv j (u i) * pderiv i p) + coeffDerivation u (pderiv j p) := by
  simp only [coeffDerivation_apply, map_sum, pderiv_mul, Finset.sum_add_distrib]
  apply congrArg (fun z : Poly (k := k) (ι := ι) =>
    (∑ i, pderiv j (u i) * pderiv i p) + z)
  apply Finset.sum_congr rfl
  intro i hi
  rw [pderiv_comm]

/-- If a derivation maps each generator of an ideal into that ideal, it preserves the ideal. -/
lemma derivation_preserves_span {R : Type*} [CommRing R] [Algebra k R]
    (D : Derivation k R R) (s : Set R)
    (h : ∀ x, x ∈ s → D x ∈ Ideal.span s) :
    ∀ x, x ∈ Ideal.span s → D x ∈ Ideal.span s := by
  intro x hx
  induction hx using Submodule.span_induction with
  | mem y hy => exact h y hy
  | zero => simpa using (Ideal.span s).zero_mem
  | add x y hx hy ihx ihy => simpa using (Ideal.span s).add_mem ihx ihy
  | smul a x hx ih =>
      rw [smul_eq_mul, Derivation.leibniz, smul_eq_mul, smul_eq_mul]
      exact (Ideal.span s).add_mem ((Ideal.span s).mul_mem_left a ih)
        ((Ideal.span s).mul_mem_right (D a) hx)

lemma coeffDerivation_preserves_gradient (f : Poly (k := k) (ι := ι))
    (hf : f ∈ gradientIdeal f) (u : ι → Poly (k := k) (ι := ι))
    (v : Poly (k := k) (ι := ι)) (hu : coeffDerivation u f = v * f) :
    ∀ p, p ∈ gradientIdeal f → coeffDerivation u p ∈ gradientIdeal f := by
  apply derivation_preserves_span
  rintro p ⟨j, rfl⟩
  have hsum : (∑ i, pderiv j (u i) * pderiv i f) ∈ gradientIdeal f := by
    apply (gradientIdeal f).sum_mem
    intro i hi
    exact (gradientIdeal f).mul_mem_left _ (partial_mem_gradient f i)
  have hd : pderiv j (coeffDerivation u f) ∈ gradientIdeal f := by
    rw [hu, pderiv_mul]
    exact (gradientIdeal f).add_mem
      ((gradientIdeal f).mul_mem_left _ hf)
      ((gradientIdeal f).mul_mem_left _ (partial_mem_gradient f j))
  have heq := pderiv_coeffDerivation u f j
  have hm := (gradientIdeal f).sub_mem hd hsum
  rw [heq] at hm
  change coeffDerivation u (pderiv j f) ∈ gradientIdeal f
  simpa only [add_sub_cancel_left] using hm

/-- Every derivation of the quotient has a polynomial coefficient lift. -/
lemma exists_coefficient_lift (f : Poly (k := k) (ι := ι))
    (D : Derivation k (Poly (k := k) (ι := ι) ⧸ Ideal.span ({f} : Set (Poly (k := k) (ι := ι))))
      (Poly (k := k) (ι := ι) ⧸ Ideal.span ({f} : Set (Poly (k := k) (ι := ι))))) :
    ∃ u : ι → Poly (k := k) (ι := ι), ∀ p,
      D (Ideal.Quotient.mk _ p) = Ideal.Quotient.mk _ (coeffDerivation u p) := by
  let I : Ideal (Poly (k := k) (ι := ι)) := Ideal.span {f}
  let A := Poly (k := k) (ι := ι) ⧸ I
  have hπ := Ideal.Quotient.mk_surjective (I := I)
  choose u hu using fun i : ι => hπ (D (Ideal.Quotient.mk I (X i)))
  refine ⟨u, ?_⟩
  have hder : D.compAlgebraMap (Poly (k := k) (ι := ι)) =
      (Algebra.linearMap (Poly (k := k) (ι := ι)) A).compDer (coeffDerivation u) := by
    apply MvPolynomial.derivation_ext
    intro i
    change D (Ideal.Quotient.mk I (X i)) = Ideal.Quotient.mk I (coeffDerivation u (X i))
    rw [coeffDerivation_X]
    exact (hu i).symm
  intro p
  exact congrArg (fun E : Derivation k (Poly (k := k) (ι := ι)) A => E p) hder

/-- The image of the gradient ideal is preserved by every actual quotient derivation.
The hypothesis f in gradientIdeal is later proved explicitly for the fixed quartic. -/
theorem quotient_gradient_stable (f : Poly (k := k) (ι := ι)) (hf : f ∈ gradientIdeal f) :
    ∀ D : Derivation k (Poly (k := k) (ι := ι) ⧸ Ideal.span ({f} : Set (Poly (k := k) (ι := ι))))
      (Poly (k := k) (ι := ι) ⧸ Ideal.span ({f} : Set (Poly (k := k) (ι := ι)))),
    ∀ x, x ∈ Ideal.map (Ideal.Quotient.mk (Ideal.span ({f} : Set (Poly (k := k) (ι := ι)))))
      (gradientIdeal f) → D x ∈ Ideal.map (Ideal.Quotient.mk (Ideal.span ({f} : Set (Poly (k := k) (ι := ι)))))
      (gradientIdeal f) := by
  intro D
  let I : Ideal (Poly (k := k) (ι := ι)) := Ideal.span {f}
  obtain ⟨u, hu⟩ := exists_coefficient_lift f D
  have hzero : Ideal.Quotient.mk I (coeffDerivation u f) = 0 := by
    rw [← hu f, (Ideal.Quotient.eq_zero_iff_mem).mpr (Ideal.subset_span (Set.mem_singleton f))]
    exact D.map_zero
  obtain ⟨v, hv⟩ := Ideal.mem_span_singleton'.mp ((Ideal.Quotient.eq_zero_iff_mem).mp hzero)
  have hpres := coeffDerivation_preserves_gradient f hf u v hv.symm
  intro x hx
  obtain ⟨p, hp, rfl⟩ :=
    (Ideal.mem_map_iff_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective).mp hx
  rw [hu p]
  exact Ideal.mem_map_of_mem _ (hpres p hp)

/-- Full quotient-ring separation assembled from explicit polynomial certificates.
The applications must prove all four hypotheses for their fixed polynomial/operator. -/
theorem quotient_separator_of_certificates (f : Poly (k := k) (ι := ι))
    (T : Module.End k (Poly (k := k) (ι := ι))) (r : ι)
    (hf : f ∈ gradientIdeal f)
    (hdescent : ∀ p, T (f * p) ∈ Ideal.span ({f} : Set (Poly (k := k) (ι := ι))))
    (horder : IsOrderLE2 T)
    (hescape : T (pderiv r f) ∉ gradientIdeal f) :
    ∃ Q : Module.End k (Poly (k := k) (ι := ι) ⧸ Ideal.span ({f} : Set (Poly (k := k) (ι := ι)))),
      (∀ p, Q (Ideal.Quotient.mk _ p) = Ideal.Quotient.mk _ (T p)) ∧
      IsOrderLE2 Q ∧ Q ∉ generated := by
  let I : Ideal (Poly (k := k) (ι := ι)) := Ideal.span {f}
  have hpres : ∀ p, p ∈ I → T p ∈ I := by
    intro p hp
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hp
    simpa [mul_comm] using hdescent a
  let Q := quotientEnd I T hpres
  have hcompat : ∀ p, Q (Ideal.Quotient.mk I p) = Ideal.Quotient.mk I (T p) := by
    intro p
    rfl
  refine ⟨Q, hcompat, ?_, ?_⟩
  · exact orderLE2_of_surjective (Ideal.Quotient.mkₐ k I)
      (Ideal.Quotient.mkₐ_surjective k I) T Q hcompat horder
  · let J := Ideal.map (Ideal.Quotient.mk I) (gradientIdeal f)
    have hIJ : I ≤ gradientIdeal f := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hf)
    apply not_generated_of_escape J (quotient_gradient_stable f hf) Q
      (Ideal.Quotient.mk I (pderiv r f))
    · exact Ideal.mem_map_of_mem _ (partial_mem_gradient f r)
    · rw [hcompat]
      exact quotient_not_mem_map hIJ hescape

end PolynomialJacobian

#print axioms NakaiFramework.quotient_separator_of_certificates

end NakaiFramework
