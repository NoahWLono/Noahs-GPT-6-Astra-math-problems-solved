import NakaiVariableSyzygy
import NakaiDeterminantRow

/-! Homogeneous determinant comparison modulo the common row-output ideal.
This is a preliminary algebraic bridge; it does not yet prove Hessian nonmembership. -/
noncomputable section
open MvPolynomial
open scoped BigOperators
namespace NakaiHomogeneousDeterminant
open NakaiDeterminantRow
variable {k ι : Type*} [Field k] [CharZero k] [Fintype ι] [DecidableEq ι]
abbrev P := MvPolynomial ι k

/-- A homogeneous syzygy among the variables can replace one row only with
an element of the ideal generated by the original row outputs. -/
theorem syzygy_row_det_mem (M : Matrix ι ι (P (k := k) (ι := ι)))
    (I : Ideal (P (k := k) (ι := ι)))
    (hy : ∀ l, rowValue M X l ∈ I) (r : ι)
    (u : ι → P (k := k) (ι := ι)) (m : ℕ)
    (hu : ∀ j, (u j).IsHomogeneous m) (hrel : ∑ j, u j * X j = 0) :
    (M.updateRow r u).det ∈ I := by
  have hs := NakaiVariableSyzygy.syzygy_functional u (fun j => M.adjugate j r) m hu hrel
  rw [← det_updateRow_eq_sum] at hs
  have hscaled : ((m+1 : ℕ) : P (k := k) (ι := ι)) * (M.updateRow r u).det ∈ I := by
    rw [hs]
    apply Submodule.sum_mem
    intro i _
    apply Submodule.sum_mem
    intro j _
    exact Ideal.mul_mem_left I _ (cofactor_wedge_mem M X I hy r j i)
  have hm : ((m+1 : ℕ) : k) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.succ_ne_zero m)
  have hh := Ideal.mul_mem_left I (C (((m+1 : ℕ) : k)⁻¹)) hscaled
  convert hh using 1
  rw [← mul_assoc, ← map_natCast C, ← map_mul, inv_mul_cancel₀ hm, map_one, one_mul]

omit [CharZero k] in
theorem det_updateRow_sub (M : Matrix ι ι (P (k := k) (ι := ι)))
    (r : ι) (u v : ι → P (k := k) (ι := ι)) :
    (M.updateRow r u).det - (M.updateRow r v).det =
      (M.updateRow r (u-v)).det := by
  simp only [det_updateRow_eq_sum, Pi.sub_apply, mul_sub, Finset.sum_sub_distrib]

/-- Replacing a homogeneous row by another of the same degree and same output
changes the determinant by an element of the row-output ideal. -/
theorem row_replacement_difference_mem (M : Matrix ι ι (P (k := k) (ι := ι)))
    (I : Ideal (P (k := k) (ι := ι)))
    (hy : ∀ l, rowValue M X l ∈ I) (r : ι)
    (u : ι → P (k := k) (ι := ι)) (m : ℕ)
    (hu : ∀ j, (u j).IsHomogeneous m) (hv : ∀ j, (M r j).IsHomogeneous m)
    (hrel : ∑ j, u j * X j = rowValue M X r) :
    (M.updateRow r u).det - M.det ∈ I := by
  have hh := syzygy_row_det_mem M I hy r (u-M r) m
    (fun j => (hu j).sub (hv j)) (by
      simp only [Pi.sub_apply, sub_mul, Finset.sum_sub_distrib]
      exact sub_eq_zero.mpr hrel)
  rw [← det_updateRow_sub, Matrix.updateRow_eq_self] at hh
  exact hh

def mixedRows (C D : Matrix ι ι (P (k := k) (ι := ι))) (s : Finset ι) :
    Matrix ι ι (P (k := k) (ι := ι)) := fun i j => if i ∈ s then C i j else D i j

/-- Homogeneous matrices with the same product with the variable column have
congruent determinants modulo the ideal containing that common output. -/
theorem determinant_comparison (C D : Matrix ι ι (P (k := k) (ι := ι)))
    (m : ℕ) (hC : ∀ i j, (C i j).IsHomogeneous m)
    (hD : ∀ i j, (D i j).IsHomogeneous m)
    (heq : ∀ i, rowValue C X i = rowValue D X i)
    (I : Ideal (P (k := k) (ι := ι))) (hy : ∀ i, rowValue C X i ∈ I) :
    C.det - D.det ∈ I := by
  have hstep : ∀ s : Finset ι, (mixedRows C D s).det - D.det ∈ I := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      have hempty : mixedRows C D ∅ = D := by ext i j; simp [mixedRows]
      rw [hempty, sub_self]
      exact I.zero_mem
    | @insert r s hrs ih =>
      let M := mixedRows C D s
      have hM : ∀ l, rowValue M X l ∈ I := by
        intro l
        by_cases hl : l ∈ s
        · simpa [M, mixedRows, rowValue, hl] using hy l
        · have hdmem : rowValue D X l ∈ I := by rw [← heq l]; exact hy l
          simpa [M, mixedRows, rowValue, hl] using hdmem
      have hr : M r = D r := by ext j; simp [M, mixedRows, hrs]
      have hh := row_replacement_difference_mem M I hM r (C r) m (hC r)
        (by simpa only [hr] using hD r) (by
          change rowValue C X r = rowValue M X r
          simp only [rowValue, hr]
          exact heq r)
      have hins : mixedRows C D (insert r s) = M.updateRow r (C r) := by
        ext i j
        by_cases hi : i = r
        · subst i; simp [mixedRows]
        · simp [mixedRows, M, Matrix.updateRow_ne hi, hi]
      rw [hins]
      have hadd := I.add_mem hh ih
      simpa only [M, sub_add_sub_cancel] using hadd
  have huniv : mixedRows C D Finset.univ = C := by ext i j; simp [mixedRows]
  simpa only [huniv] using hstep Finset.univ

#print axioms syzygy_row_det_mem
#print axioms determinant_comparison
end NakaiHomogeneousDeterminant
