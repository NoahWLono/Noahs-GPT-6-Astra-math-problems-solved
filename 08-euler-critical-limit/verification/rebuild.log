BUILD EndpointWeights
'EulerScalingAnalytic.weight_endpoint_pos' depends on axioms: [propext, Classical.choice, Quot.sound]
'EulerScalingAnalytic.endpoint_eq_product' depends on axioms: [propext, Classical.choice, Quot.sound]
BUILD ParameterDecay
EulerScaling.scaling_log_identity (n p : ℕ) (hn : 1 ≤ n) : Real.log (↑n ^ 3 / 2 ^ p) = 3 * Real.log ↑n - ↑p * Real.log 2
EulerScaling.parameter_quotient_identity (n p : ℕ) (hn : 1 ≤ n) :
  ↑p / ↑n = (3 * (Real.log ↑n / ↑n) - Real.log (↑n ^ 3 / 2 ^ p) / ↑n) / Real.log 2
EulerScaling.tendsto_parameter_div_scale_zero (n p : ℕ → ℕ) (hn_pos : ∀ (ℓ : ℕ), 1 ≤ n ℓ) (hn : Tendsto n atTop atTop)
  (lambda0 : ℝ) (hlambda0 : 0 < lambda0) (hlambda : Tendsto (fun ℓ => ↑(n ℓ) ^ 3 / 2 ^ p ℓ) atTop (𝓝 lambda0)) :
  Tendsto (fun ℓ => ↑(p ℓ) / ↑(n ℓ)) atTop (𝓝 0)
'EulerScaling.scaling_log_identity' depends on axioms: [propext, Classical.choice, Quot.sound]
'EulerScaling.parameter_quotient_identity' depends on axioms: [propext, Classical.choice, Quot.sound]
'EulerScaling.tendsto_parameter_div_scale_zero' depends on axioms: [propext, Classical.choice, Quot.sound]
