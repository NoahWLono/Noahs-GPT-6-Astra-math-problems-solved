import ProjectiveOrder
import ExtensionDegree

/-! Combined finite-extension endpoint of the recurrence obstruction, in
an explicit-matrix formulation over a genuine finite field extension. -/
namespace Astra01
noncomputable section
open scoped MatrixGroups LinearAlgebra.Projectivization

variable {F K : Type*} [Field F] [Fintype F] [Field K] [Fintype K]
  [Algebra F K]
local instance : MulAction (GL (Fin 2) K) (ℙ K (Plane K)) := projectiveMatrixAction

/-- Combined T4 in cyclic-sequence form, using the actual extension degree
finrank_F K and the actual field cardinality |F|, rather than assuming the
cardinality-power relationship or the field alternatives. -/
theorem finite_extension_projective_recurrence
    (M : GL (Fin 2) K) (z : ℕ → ℙ K (Plane K)) (n : ℕ)
    (hn : n.Prime) (hn3 : 3 ≤ n)
    (hstep : ∀ i < n, z (i+1) = M • z i)
    (hclose : z n = z 0) (hnonconstant : ∃ i < n, z i ≠ z 0) :
    Function.Injective (fun i : Fin n => z i.val) ∧
    orderOf (MulAction.toPermHom (GL (Fin 2) K) (ℙ K (Plane K)) M) = n ∧
    (n = ringChar F ∨ n ∣ (Fintype.card F)^(Module.finrank F K)-1 ∨
      n ∣ (Fintype.card F)^(Module.finrank F K)+1) ∧
    (n ≠ ringChar F →
      0 < Module.finrank F K ∧
      orderOf (Fintype.card F : ZMod n) ∣ 2 * Module.finrank F K ∧
      orderOf (Fintype.card F : ZMod n) /
        Nat.gcd (orderOf (Fintype.card F : ZMod n)) 2 ∣ Module.finrank F K) := by
  have hcard : Fintype.card K = (Fintype.card F)^(Module.finrank F K) :=
    Module.card_eq_pow_finrank
  have hchar : ringChar F = ringChar K := Algebra.ringChar_eq F K
  have halt := projective_prime_recurrence_field_alternatives M z n hn hstep hclose hnonconstant
  rw [← hchar, hcard] at halt
  refine ⟨prime_recurrence_injective (M • ·) z n hn hstep hclose hnonconstant,
    projective_recurrence_exact_order M z n hn hn3 hstep hclose hnonconstant, halt, ?_⟩
  intro hne
  have hpm := halt.resolve_left hne
  have hk : 0 < Module.finrank F K := by
    by_contra! h
    have hz : Module.finrank F K = 0 := Nat.eq_zero_of_le_zero h
    rw [hz, pow_zero] at hcard
    have hgt : 1 < Fintype.card K := Fintype.one_lt_card
    omega
  exact ⟨hk, order_dvd_twice_extension n (Fintype.card F) (Module.finrank F K)
    Fintype.card_pos hpm,
    minimal_extension_degree_divides n (Fintype.card F) (Module.finrank F K)
      Fintype.card_pos hpm⟩

/-- T4 for translation by a point of exact odd prime order in an arbitrary
additive group. The function is only required to obey the recurrence and be
nonconstant on the cyclic subgroup generated by G. In particular this
specializes to the group of rational points of an elliptic curve. -/
theorem cyclic_subgroup_projective_recurrence
    {A : Type*} [AddGroup A] (G : A) (f : A → ℙ K (Plane K))
    (M : GL (Fin 2) K) (n : ℕ) (hn : n.Prime) (hn3 : 3 ≤ n)
    (horder : addOrderOf G = n)
    (hrec : ∀ P ∈ AddSubgroup.zmultiples G, f (P+G) = M • f P)
    (hnonconstant : ∃ P ∈ AddSubgroup.zmultiples G, f P ≠ f 0) :
    Set.InjOn f (AddSubgroup.zmultiples G) ∧
    orderOf (MulAction.toPermHom (GL (Fin 2) K) (ℙ K (Plane K)) M) = n ∧
    (n = ringChar F ∨ n ∣ (Fintype.card F)^(Module.finrank F K)-1 ∨
      n ∣ (Fintype.card F)^(Module.finrank F K)+1) ∧
    (n ≠ ringChar F →
      0 < Module.finrank F K ∧
      orderOf (Fintype.card F : ZMod n) ∣ 2 * Module.finrank F K ∧
      orderOf (Fintype.card F : ZMod n) /
        Nat.gcd (orderOf (Fintype.card F : ZMod n)) 2 ∣ Module.finrank F K) := by
  classical
  let z : ℕ → ℙ K (Plane K) := fun i => f (i • G)
  have hG : IsOfFinAddOrder G := addOrderOf_pos_iff.mp (by rw [horder]; exact hn.pos)
  have hreps : ∀ P ∈ AddSubgroup.zmultiples G, ∃ i : Fin n, i.val • G = P := by
    intro P hP
    obtain ⟨i, hi⟩ := (finEquivZMultiples hG).surjective ⟨P,hP⟩
    have hval := congrArg Subtype.val hi
    change i.val • G = P at hval
    exact ⟨⟨i.val, by simpa only [horder] using i.isLt⟩, hval⟩
  have hstep : ∀ i < n, z (i+1) = M • z i := by
    intro i _
    simpa [z, add_nsmul] using hrec (i • G) (AddSubgroup.nsmul_mem_zmultiples G i)
  have hclose : z n = z 0 := by
    have hg0 : n • G = 0 := by rw [← horder]; exact addOrderOf_nsmul_eq_zero G
    simp [z, hg0]
  have hnon : ∃ i < n, z i ≠ z 0 := by
    obtain ⟨P,hP,hne⟩ := hnonconstant
    obtain ⟨i,hi⟩ := hreps P hP
    exact ⟨i.val, i.isLt, by simpa [z,hi] using hne⟩
  obtain ⟨hinj, hrest⟩ := finite_extension_projective_recurrence (F := F) M z n hn hn3
    hstep hclose hnon
  refine ⟨?_, hrest⟩
  intro P hP Q hQ heq
  obtain ⟨i,hi⟩ := hreps P hP
  obtain ⟨j,hj⟩ := hreps Q hQ
  have hij : i = j := hinj (by simpa [z,hi,hj] using heq)
  calc
    P = i.val • G := hi.symm
    _ = j.val • G := by rw [hij]
    _ = Q := hj

#print axioms cyclic_subgroup_projective_recurrence
#print axioms finite_extension_projective_recurrence
end
end Astra01
